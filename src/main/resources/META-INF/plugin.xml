<idea-plugin>
  <id>nl.netonic.worktree-workspaces</id>
  <name>Worktree Workspaces</name>
  <version>0.2.4</version>
  <vendor url="https://netonic.nl">Netonic</vendor>
  <idea-version since-build="262"/>

  <description><![CDATA[
    <p>Work on several tickets across a backend and a frontend repo without juggling windows.</p>
    <ul>
      <li>A <b>workspace</b> is one folder per client: <code>main/</code> holds the real clones,
          every ticket gets its own folder with git worktrees of the repos it touches.</li>
      <li>Each ticket opens as one tab (<i>klant-x · LOGIN-42</i>) holding all its repos.</li>
      <li><code>.env</code>, <code>vendor/</code> and <code>node_modules/</code> are copied from main
          with APFS clones: instant, no extra disk space.</li>
      <li>A toolbar switcher and a <i>Workspaces</i> panel show every ticket with branch and git state.</li>
      <li><i>Finish ticket</i> checks for uncommitted / unpushed work, then removes the worktrees.</li>
    </ul>
    <p>Free and open source on <a href="https://github.com/Tygovanommen/worktree-workspaces">GitHub</a>.
       Found a bug? <i>Tools › Workspaces › Report an Issue…</i></p>
  ]]></description>

  <change-notes><![CDATA[
    <p>0.2.4</p>
    <ul>
      <li>New Workspace: <i>Open in</i> a new tab, a new window or this window; the default is set in Settings.</li>
      <li>macOS: PhpStorm's <i>Open Project</i> dialog gets <i>Merge in Current</i>, which opens any project as a tab
          of the current window (in place of <i>Attach</i>; switch it off in Settings to get <i>Attach</i> back).</li>
      <li>Each open ticket gets its own toolbar color, so tabs side by side are easy to tell apart. A color you pick
          yourself (Change Project Color) is kept.</li>
      <li>Recent Projects shows only <i>main</i> of each workspace: closed tickets and the bare workspace folder are
          removed. Tabs open when PhpStorm quits still reopen.</li>
      <li>Fixed: after <i>Get from VCS</i> the "put it in a workspace" dialog didn't appear.</li>
    </ul>
    <p>0.2.3</p>
    <ul>
      <li>Toolbar switcher: the current workspace's tickets, other workspaces as submenus (open tabs first) and
          <i>Search All Tickets…</i>. <i>Switch Ticket</i> searches every ticket as <i>workspace / ticket</i>.</li>
      <li>Repo terminal tabs come back when you reopen the Terminal after closing all its tabs.</li>
      <li>The ▶ next to a command in a README runs it in that README's folder (option in Settings).</li>
    </ul>
    <p>0.2.2</p>
    <ul>
      <li>Undo Workspace: moves the repos back out of <code>main/</code> (to where they came from), removes the
          tickets' worktrees (branches stay), the links and the workspace folder.</li>
      <li>A workspace with one repo has it in <code>main/</code> itself; each ticket folder is a worktree of it.</li>
      <li>New Workspace: repo rows can be removed; the starting rows are set in Settings (default backend, frontend).</li>
      <li>Untracked <code>.idea/</code> and <code>.DS_Store</code> no longer count as changes.</li>
    </ul>
    <p>0.2.1</p>
    <ul>
      <li>New Workspace / Get from VCS: a workspace may have the same name as the checkout it adopts
          (<code>~/PhpstormProjects/klant-x</code> becomes workspace <code>klant-x</code>); the checkout is
          moved aside first, then into <code>main/</code>.</li>
    </ul>
    <p>0.2.0</p>
    <ul>
      <li>Links next to the workspace per repo (<code>klant-x-backend</code>, <code>klant-x-login-42-backend</code>)
          so Herd / Valet find every checkout; made and removed automatically.</li>
      <li>A terminal tab per repo when a ticket or main opens for the first time; <i>Open in Terminal</i> per repo.</li>
      <li>After <i>Get from VCS</i>: offer to put the clone in a new or existing workspace.</li>
      <li>New Ticket: <i>Branch from</i> lists local and remote branches like the Git popup; ticket keys may contain
          <code>/</code> (<code>LOGIN-42/login-form</code>).</li>
      <li>Settings › Tools › Worktree Workspaces for all options.</li>
    </ul>
    <p>0.1.0 — first version: workspaces, tickets as tabs, toolbar switcher, Workspaces panel, finish ticket.</p>
  ]]></change-notes>

  <depends>com.intellij.modules.platform</depends>
  <depends>Git4Idea</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="Workspaces" anchor="left" secondary="false" icon="/icons/workspaces.svg"
                factoryClass="nl.netonic.workspaces.ide.ui.WorkspacesToolWindowFactory"/>
    <postStartupActivity implementation="nl.netonic.workspaces.ide.TicketStartupActivity"/>
    <notificationGroup id="Worktree Workspaces" displayType="BALLOON"/>
    <applicationConfigurable parentId="tools" id="nl.netonic.worktree-workspaces" displayName="Worktree Workspaces"
                             instance="nl.netonic.workspaces.ide.ui.WorkspacesConfigurable"/>
    <!-- before PhpStorm's own listeners, which open the clone as a project -->
    <checkoutListener implementation="nl.netonic.workspaces.ide.CloneListener" id="WorktreeWorkspacesClone"
                      order="before ProjectDirCheckoutListener"/>
    <!-- the Open Project dialog's third button (PhpStorm's Attach) while the option is on, macOS only -->
    <projectAttachProcessor implementation="nl.netonic.workspaces.ide.OpenAsTab" order="first"/>
  </extensions>

  <applicationListeners>
    <listener class="nl.netonic.workspaces.ide.RefreshListeners$OnActivation"
              topic="com.intellij.openapi.application.ApplicationActivationListener"/>
    <listener class="nl.netonic.workspaces.ide.RefreshListeners$OnProjectClose"
              topic="com.intellij.openapi.project.ProjectCloseListener"/>
    <listener class="nl.netonic.workspaces.ide.RecentProjects$OnExit"
              topic="com.intellij.ide.AppLifecycleListener"/>
  </applicationListeners>

  <projectListeners>
    <listener class="nl.netonic.workspaces.ide.RepoTerminals$OnTerminalShown"
              topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
  </projectListeners>

  <actions>
    <action id="WorktreeWorkspaces.NewTicket" class="nl.netonic.workspaces.ide.actions.NewTicketAction"
            text="New Ticket…" description="Create a ticket folder with a worktree per repo and open it as a tab"
            icon="AllIcons.General.Add"/>
    <action id="WorktreeWorkspaces.NewWorkspace" class="nl.netonic.workspaces.ide.actions.NewWorkspaceAction"
            text="New Workspace…" description="Create a workspace folder and clone or move its repos into main/"
            icon="AllIcons.Actions.NewFolder"/>
    <action id="WorktreeWorkspaces.AddRepo" class="nl.netonic.workspaces.ide.actions.AddRepoAction"
            text="Add Repo to Workspace…" description="Clone a repo into main/ or move an existing checkout there"
            icon="AllIcons.Vcs.Clone"/>
    <action id="WorktreeWorkspaces.AddExistingWorkspace" class="nl.netonic.workspaces.ide.actions.AddExistingWorkspaceAction"
            text="Add Existing Workspace…" description="Register a folder that already has a .workspace.json"
            icon="AllIcons.Actions.AddDirectory"/>
    <action id="WorktreeWorkspaces.UndoWorkspace" class="nl.netonic.workspaces.ide.actions.UndoWorkspaceAction"
            text="Undo Workspace…" description="Move the repos back out as normal checkouts and remove the workspace"
            icon="AllIcons.Actions.Rollback"/>
    <action id="WorktreeWorkspaces.FinishTicket" class="nl.netonic.workspaces.ide.actions.FinishTicketAction"
            text="Finish Ticket…" description="Close the tab and remove the ticket's worktrees and folder"
            icon="AllIcons.Actions.Commit"/>
    <action id="WorktreeWorkspaces.SwitchTicket" class="nl.netonic.workspaces.ide.actions.SwitchTicketAction"
            text="Switch Ticket…" description="Search every ticket in every workspace and jump to its tab" icon="AllIcons.Vcs.Branch"/>
    <action id="WorktreeWorkspaces.Refresh" class="nl.netonic.workspaces.ide.actions.SimpleActions$Refresh"
            text="Refresh" description="Re-scan workspaces and git state" icon="AllIcons.Actions.Refresh"/>
    <action id="WorktreeWorkspaces.OpenSelected" class="nl.netonic.workspaces.ide.actions.SimpleActions$OpenSelected"
            text="Open as Tab" description="Open or focus this ticket"/>
    <action id="WorktreeWorkspaces.AddWorktreeToTicket"
            class="nl.netonic.workspaces.ide.actions.SimpleActions$AddWorktreeToTicket"
            text="Add Repo to Ticket" description="Give this ticket its own worktree of this repo"
            icon="AllIcons.General.Add"/>
    <action id="WorktreeWorkspaces.Reveal" class="nl.netonic.workspaces.ide.actions.SimpleActions$Reveal"
            text="Reveal in File Manager" description="Show the folder in Finder / Explorer / the file manager"/>
    <action id="WorktreeWorkspaces.EditConfig" class="nl.netonic.workspaces.ide.actions.SimpleActions$EditConfig"
            text="Edit .workspace.json" description="Repos, base branches, files to copy, branch pattern"
            icon="AllIcons.Actions.Edit"/>
    <action id="WorktreeWorkspaces.Remove" class="nl.netonic.workspaces.ide.actions.SimpleActions$Remove"
            text="Remove from List" description="Forget this workspace; nothing is deleted"
            icon="AllIcons.General.Remove"/>
    <action id="WorktreeWorkspaces.OpenSettings" class="nl.netonic.workspaces.ide.actions.SimpleActions$OpenSettings"
            text="Settings…" description="Settings › Tools › Worktree Workspaces" icon="AllIcons.General.Settings"/>
    <action id="WorktreeWorkspaces.OpenRepoTerminal" class="nl.netonic.workspaces.ide.actions.SimpleActions$OpenRepoTerminal"
            text="Open in Terminal" description="Open a terminal tab in this repo's folder"
            icon="AllIcons.Nodes.Console"/>
    <action id="WorktreeWorkspaces.ReportIssue" class="nl.netonic.workspaces.ide.actions.SimpleActions$ReportIssue"
            text="Report an Issue…" description="Open a bug report on GitHub with your PhpStorm and plugin versions filled in"
            icon="AllIcons.General.ShowWarning"/>
    <action id="WorktreeWorkspaces.OpenGitHub" class="nl.netonic.workspaces.ide.actions.SimpleActions$OpenGitHub"
            text="Worktree Workspaces on GitHub" description="Docs, questions and stars"
            icon="AllIcons.Vcs.Vendors.Github"/>

    <action id="WorktreeWorkspaces.ToolbarWidget" class="nl.netonic.workspaces.ide.actions.TicketSwitcherWidgetAction"
            text="Ticket Switcher" description="Switch ticket">
      <add-to-group group-id="MainToolbarLeft" anchor="after" relative-to-action="main.toolbar.Project"/>
    </action>

    <group id="WorktreeWorkspaces.Options" text="Options" popup="true" icon="AllIcons.General.GearPlain">
      <reference ref="WorktreeWorkspaces.OpenSettings"/>
      <reference ref="WorktreeWorkspaces.EditConfig"/>
      <reference ref="WorktreeWorkspaces.AddExistingWorkspace"/>
      <separator/>
      <reference ref="WorktreeWorkspaces.ReportIssue"/>
      <reference ref="WorktreeWorkspaces.OpenGitHub"/>
    </group>

    <group id="WorktreeWorkspaces.Toolbar">
      <reference ref="WorktreeWorkspaces.NewTicket"/>
      <reference ref="WorktreeWorkspaces.NewWorkspace"/>
      <reference ref="WorktreeWorkspaces.AddRepo"/>
      <reference ref="WorktreeWorkspaces.Refresh"/>
      <separator/>
      <reference ref="WorktreeWorkspaces.FinishTicket"/>
      <separator/>
      <reference ref="WorktreeWorkspaces.Options"/>
    </group>

    <group id="WorktreeWorkspaces.TreePopup">
      <reference ref="WorktreeWorkspaces.OpenSelected"/>
      <reference ref="WorktreeWorkspaces.AddWorktreeToTicket"/>
      <reference ref="WorktreeWorkspaces.OpenRepoTerminal"/>
      <reference ref="WorktreeWorkspaces.NewTicket"/>
      <reference ref="WorktreeWorkspaces.FinishTicket"/>
      <separator/>
      <reference ref="WorktreeWorkspaces.Reveal"/>
      <reference ref="WorktreeWorkspaces.EditConfig"/>
      <reference ref="WorktreeWorkspaces.AddRepo"/>
      <separator/>
      <reference ref="WorktreeWorkspaces.Refresh"/>
      <reference ref="WorktreeWorkspaces.Remove"/>
      <reference ref="WorktreeWorkspaces.UndoWorkspace"/>
    </group>

    <group id="WorktreeWorkspaces.Menu" text="Workspaces" popup="true">
      <reference ref="WorktreeWorkspaces.SwitchTicket"/>
      <reference ref="WorktreeWorkspaces.NewTicket"/>
      <reference ref="WorktreeWorkspaces.FinishTicket"/>
      <separator/>
      <reference ref="WorktreeWorkspaces.NewWorkspace"/>
      <reference ref="WorktreeWorkspaces.AddRepo"/>
      <reference ref="WorktreeWorkspaces.AddExistingWorkspace"/>
      <reference ref="WorktreeWorkspaces.UndoWorkspace"/>
      <separator/>
      <reference ref="WorktreeWorkspaces.ReportIssue"/>
      <reference ref="WorktreeWorkspaces.OpenGitHub"/>
      <add-to-group group-id="ToolsMenu" anchor="first"/>
    </group>
  </actions>
</idea-plugin>
